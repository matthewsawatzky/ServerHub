servers:
  - id: nairwell
    name: "nairwell"
    host: "192.168.1.10"
    port: 22
    user: "youruser"
    key: "~/.ssh/id_ed25519"
    tags: ["homelab", "main"]
    notes: "Main server, runs Docker stacks"
    quick_actions:
      - label: "Run backup"
        command: "~/scripts/backup.sh"
      - label: "Pull all images"
        command: "docker compose -f ~/compose.yml pull"
      - label: "Start game server"      # runs under tmux; observe output in the Jobs panel
        command: "./game-server"
        mode: detached
        session: game-server            # optional fixed session for service-like jobs

  - id: rpi5
    name: "rpi5"
    host: "192.168.1.20"
    port: 22
    user: "youruser"
    key: "~/.ssh/id_ed25519"
    tags: ["homelab"]
    notes: "Raspberry Pi 5"
    quick_actions: []
