#!/usr/bin/env bash
set -euo pipefail

# Dev helper — native build for THIS machine, self-contained in ./test-config/.
#
#   ./dev                build ./serverhub (this machine's OS/arch, fast)
#   ./dev race           same build with the Go race detector
#   ./dev run [args...]  build, then run with args passed to the binary
#
# Every run starts clean: the previous binary and ./test-config/ are deleted
# first, so dev always begins from a fresh state (the onboarding wizard shows
# again on each run). State never touches the live installation.
# The starter config listens on port 7080 (the live default is 7070) and does
# not auto-open the browser.
#
# Full cross-compiled release build (dist/, app bundles, DMGs): ./build.sh

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SRC_DIR="${SCRIPT_DIR}/go"
OUT="${SCRIPT_DIR}/serverhub"
TEST_CONFIG_DIR="${SCRIPT_DIR}/test-config"

GREEN='\033[0;32m'; CYAN='\033[0;36m'; RED='\033[0;31m'; DIM='\033[2m'; BOLD='\033[1m'; RESET='\033[0m'
step() { echo -e "  ${CYAN}▸${RESET} $*"; }
ok()   { echo -e "  ${GREEN}✓${RESET} $*"; }
err()  { echo -e "  ${RED}✗${RESET} $*" >&2; }

MODE="build"
case "${1:-}" in
  race) MODE="race"; shift ;;
  run)  MODE="run";  shift ;;
  ""|dev) ;;
  *) err "Unknown option: $1"; echo "Usage: $(basename "$0") [race | run [args...]]"; exit 1 ;;
esac

# ── Clean slate ────────────────────────────────────────────────────────────────

step "Cleaning previous dev binary and state..."
rm -f "${OUT}" "${OUT}.exe"
rm -rf "${TEST_CONFIG_DIR}"

# Seed a fresh dev config.
mkdir -p "${TEST_CONFIG_DIR}"
cat > "${TEST_CONFIG_DIR}/config.yaml" <<'EOF'
# ServerHub DEV configuration (regenerated by ./dev on every run)
# This directory is only used by dev builds — your live installation keeps its
# own state in the OS config dir.

server:
  port: 7080            # distinct from the live default (7070) to avoid clashes
  bind: "127.0.0.1"
  open_browser: false

theme: "green"
hue: 120                # accent colour (0-360)
shade: 20               # surface shade 0=black … 100=white

terminal:
  background: "#0e0e10"
  foreground: "#e0e0e8"
  accent: "#639922"

servers: []
EOF
ok "Fresh  ${TEST_CONFIG_DIR}/config.yaml ${DIM}(port 7080)${RESET}"

# ── Build ──────────────────────────────────────────────────────────────────────

# Bake the dev config dir into the binary itself: the whole state (config +
# auth + known_hosts) resolves to ./test-config/ no matter how it is started.
LDFLAGS="-X serverhub/internal/storage.devDir=${TEST_CONFIG_DIR}"

if [[ "$MODE" == "race" ]]; then
  step "Building (race detector enabled)..."
  ( cd "${SRC_DIR}" && go build -race -ldflags "${LDFLAGS}" -o "${OUT}" . )
else
  step "Building for $(go env GOOS 2>/dev/null || uname)/$(go env GOARCH 2>/dev/null || uname -m)..."
  ( cd "${SRC_DIR}" && CGO_ENABLED=0 go build -ldflags "${LDFLAGS}" -o "${OUT}" . )
fi

chmod +x "${OUT}"
size=$(du -h "${OUT}" | cut -f1 | xargs)
ok "Built  ${OUT}  ${DIM}($size, config: ./test-config/)${RESET}"

if [[ "$MODE" == "run" ]]; then
  exec "${OUT}" "$@"
fi