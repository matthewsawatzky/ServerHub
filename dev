#!/usr/bin/env bash
set -euo pipefail

# Dev helper — native build for THIS machine, self-contained in ./test-config/.
#
#   ./dev                build ./serverhub (resets ./test-config/)
#   ./dev race           same build with the Go race detector (resets state)
#   ./dev run [args...]  build, then run; keeps ./test-config/ if it exists
#
# State never touches the live installation. Use ./dev run for iterative work.
# The starter config listens on port 7080 (the live default is 7070) and does
# not auto-open the browser.
#
# Full cross-compiled release build (dist/, app bundles, DMGs): ./build.sh

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SRC_DIR="${SCRIPT_DIR}/go"
OUT="${SCRIPT_DIR}/serverhub"
TEST_CONFIG_DIR="${SCRIPT_DIR}/test-config"

GREEN='\033[0;32m'; CYAN='\033[0;36m'; RED='\033[0;31m'; DIM='\033[2m'; BOLD='\033[1m'; RESET='\033[0m'
step() { echo -e "  ${CYAN}▸${RESET} $*"; }
ok()   { echo -e "  ${GREEN}✓${RESET} $*"; }
err()  { echo -e "  ${RED}✗${RESET} $*" >&2; }

MODE="build"
KEEP_STATE=0
case "${1:-}" in
  race) MODE="race"; shift ;;
  run)  MODE="run";  shift ;;
  ""|dev) ;;
  *) err "Unknown option: $1"; echo "Usage: $(basename "$0") [race | run [args...]]"; exit 1 ;;
esac
if [[ "$MODE" == "run" && -f "${TEST_CONFIG_DIR}/config.yaml" ]]; then
  KEEP_STATE=1
fi

# ── Preserve appearance ───────────────────────────────────────────────────────
#
# Prefer the colours already in ./test-config (so tweaking the dev UI survives a
# rebuild), then fall back to the live install's colours. Read-only either way.

COLOR_CFG=""
if [[ -r "${TEST_CONFIG_DIR}/config.yaml" ]]; then
  COLOR_CFG="${TEST_CONFIG_DIR}/config.yaml"
else
  for candidate in \
    "${HOME}/Library/Application Support/ServerHub/config.yaml" \
    "${XDG_CONFIG_HOME:-${HOME}/.config}/ServerHub/config.yaml" \
    "${APPDATA:-}/ServerHub/config.yaml"; do
    if [[ -n "${candidate}" && -r "${candidate}" ]]; then
      COLOR_CFG="${candidate}"
      break
    fi
  done
fi

clean_yaml() {
  sed -e 's/[[:space:]]#.*$//' -e 's/[[:space:]]*$//' \
      -e "s/^['\"]//" -e "s/['\"]$//"
}

live_scalar() { # file key
  sed -n "s/^$2:[[:space:]]*//p" "$1" | head -n1 | clean_yaml
}

live_terminal() { # file key
  awk -v key="$2" '
    /^terminal:[[:space:]]*$/ { in_term = 1; next }
    in_term && /^[^[:space:]]/ { in_term = 0 }
    in_term && $1 == key":" { sub(/^[^:]*:[[:space:]]*/, ""); print; exit }
  ' "$1" | clean_yaml
}

COLOR_HUE="120"; COLOR_SHADE="20"; COLOR_ANIMATIONS="true"
COLOR_TERM_BG="#0e0e10"; COLOR_TERM_FG="#e0e0e8"; COLOR_TERM_ACCENT="#639922"
if [[ -n "${COLOR_CFG}" ]]; then
  COLOR_HUE="$(live_scalar "${COLOR_CFG}" hue)"; COLOR_HUE="${COLOR_HUE:-120}"
  COLOR_SHADE="$(live_scalar "${COLOR_CFG}" shade)"; COLOR_SHADE="${COLOR_SHADE:-20}"
  COLOR_ANIMATIONS="$(live_scalar "${COLOR_CFG}" animations)"; COLOR_ANIMATIONS="${COLOR_ANIMATIONS:-true}"
  COLOR_TERM_BG="$(live_terminal "${COLOR_CFG}" background)"; COLOR_TERM_BG="${COLOR_TERM_BG:-#0e0e10}"
  COLOR_TERM_FG="$(live_terminal "${COLOR_CFG}" foreground)"; COLOR_TERM_FG="${COLOR_TERM_FG:-#e0e0e8}"
  COLOR_TERM_ACCENT="$(live_terminal "${COLOR_CFG}" accent)"; COLOR_TERM_ACCENT="${COLOR_TERM_ACCENT:-#639922}"
fi

# ── Clean slate ────────────────────────────────────────────────────────────────

step "Cleaning previous dev binary..."
rm -f "${OUT}" "${OUT}.exe"
if [[ "$KEEP_STATE" == "1" ]]; then
  ok "Keeping existing dev state in ${TEST_CONFIG_DIR}"
else
  rm -rf "${TEST_CONFIG_DIR}"
fi

# Seed a fresh dev config using the preserved appearance.
if [[ "$KEEP_STATE" != "1" ]]; then
mkdir -p "${TEST_CONFIG_DIR}"
cat > "${TEST_CONFIG_DIR}/config.yaml" <<EOF
# ServerHub DEV configuration (regenerated by ./dev on every run)
# This directory is only used by dev builds — your live installation keeps its
# own state in the OS config dir.

server:
  port: 7080            # distinct from the live default (7070) to avoid clashes
  bind: "127.0.0.1"
  open_browser: false

hue: ${COLOR_HUE}                # accent colour (0-360)
shade: ${COLOR_SHADE}               # surface shade 0=black … 100=white
animations: ${COLOR_ANIMATIONS}

terminal:
  background: "${COLOR_TERM_BG}"
  foreground: "${COLOR_TERM_FG}"
  accent: "${COLOR_TERM_ACCENT}"

EOF
if [[ -n "${COLOR_CFG}" ]]; then
  ok "Colours from ${COLOR_CFG} ${DIM}(hue ${COLOR_HUE}, shade ${COLOR_SHADE})${RESET}"
else
  ok "Colours ${DIM}(defaults — no saved dev or live config found)${RESET}"
fi

# Seed the developer's test server and skip the onboarding wizard.
cat > "${TEST_CONFIG_DIR}/servers.conf" <<'EOF'
# ServerHub DEV server inventory (regenerated by ./dev)
servers:
  - id: gmcardle
    name: "GMcardle"
    host: "100.126.205.60"
    port: 22
    user: "admin-mat"
    key: "~/.ssh/id_ed25519"
    tags: ["dev"]
    notes: "Seeded by ./dev for local testing"
    quick_actions: []
EOF

cat > "${TEST_CONFIG_DIR}/auth.json" <<'EOF'
{"version":1,"mode":"opt_out","created_at":"2026-01-01T00:00:00Z"}
EOF

ok "Fresh  ${TEST_CONFIG_DIR}/config.yaml ${DIM}(port 7080)${RESET}"
ok "Seeded ${TEST_CONFIG_DIR}/servers.conf ${DIM}(GMcardle)${RESET}"
ok "Seeded ${TEST_CONFIG_DIR}/auth.json ${DIM}(onboarding skipped)${RESET}"
fi

# `./dev run` binds to the developer's Tailscale address so the UI is reachable
# from other devices. Build-only runs keep loopback.
if [[ "$MODE" == "run" ]]; then
  DEV_BIND="${DEV_BIND:-100.74.121.84}"
  cfg="${TEST_CONFIG_DIR}/config.yaml"
  if [[ -f "${cfg}" ]]; then
    tmp="${cfg}.tmp"
    awk -v bind="${DEV_BIND}" '
      BEGIN { done = 0 }
      /^[[:space:]]*bind:[[:space:]]*/ && !done {
        sub(/bind:[[:space:]]*.*/, "bind: \"" bind "\"")
        done = 1
      }
      { print }
    ' "${cfg}" > "${tmp}" && mv "${tmp}" "${cfg}"
    ok "Dev bind ${DEV_BIND} ${DIM}(http://${DEV_BIND}:7080)${RESET}"
  fi
fi

# ── Build ──────────────────────────────────────────────────────────────────────

# Bake the dev config dir into the binary itself: the whole state (config,
# servers, auth, known_hosts) resolves to ./test-config/ no matter how it is started.
LDFLAGS="-X serverhub/internal/storage.devDir=${TEST_CONFIG_DIR}"

if [[ "$MODE" == "race" ]]; then
  step "Building (race detector enabled)..."
  ( cd "${SRC_DIR}" && go build -race -ldflags "${LDFLAGS}" -o "${OUT}" . )
else
  step "Building for $(go env GOOS 2>/dev/null || uname)/$(go env GOARCH 2>/dev/null || uname -m)..."
  ( cd "${SRC_DIR}" && CGO_ENABLED=0 go build -ldflags "${LDFLAGS}" -o "${OUT}" . )
fi

chmod +x "${OUT}"
size=$(du -h "${OUT}" | cut -f1 | xargs)
ok "Built  ${OUT}  ${DIM}($size, config: ./test-config/)${RESET}"

if [[ "$MODE" == "run" ]]; then
  if [[ -t 0 ]]; then
    exec "${OUT}" "$@"
  fi
  # No TTY (e.g. `./dev run ... &` in a script): the server exits when stdin
  # reads EOF. Feed it a never-ending, never-writing stdin instead; the
  # interactive `q to quit` path is untouched for TTY users.
  exec "${OUT}" "$@" < <(tail -f /dev/null)
fi